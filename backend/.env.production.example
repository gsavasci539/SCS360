APP_ENV=production
BUSINESS_TIMEZONE=Europe/Istanbul
SEED_DEMO_DATA=false
PRIVATE_UPLOAD_DIR=private_uploads
# DATABASE_URL is injected by docker-compose. Set it explicitly for a direct installation.
DATABASE_URL=postgresql+asyncpg://scs360:REPLACE_PASSWORD@127.0.0.1:5432/school_management
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=https://REPLACE_PUBLIC_HOST
PASSWORD_RESET_URL=https://REPLACE_PUBLIC_HOST/reset-password
CHATBOT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2
CHATBOT_LLM_TIMEOUT_SECONDS=12
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_TIMEOUT_SECONDS=20
NOTIFICATION_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SCS360
SMS_PROVIDER=netgsm
SMS_API_URL=https://api.netgsm.com.tr/sms/rest/v2/send
SMS_USERNAME=
SMS_PASSWORD=
SMS_HEADER=
WHATSAPP_API_URL=https://graph.facebook.com/REPLACE_SUPPORTED_VERSION
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=https://REPLACE_PUBLIC_HOST/api/payments/iyzico/callback
IYZICO_PAYMENT_ENABLED=false
IYZICO_ORGANIZATION_ID=
# Per-school merchant settings. Keep encryption key stable across deployments.
SCHOOL_PAYMENT_ENCRYPTION_KEY=
SCHOOL_PAYMENT_CALLBACK_URL=https://REPLACE_PUBLIC_HOST/api/payments/iyzico/callback
# SCS360 membership revenue uses its own merchant, never a school account.
SAAS_PAYMENT_ENABLED=false
SAAS_IYZICO_API_KEY=
SAAS_IYZICO_SECRET_KEY=
SAAS_IYZICO_BASE_URL=https://api.iyzipay.com
SAAS_IYZICO_CALLBACK_URL=https://REPLACE_PUBLIC_HOST/api/subscription/iyzico/callback
SAAS_PORTAL_URL=https://REPLACE_PUBLIC_HOST
SAAS_CHECKOUT_ENCRYPTION_KEY=
SAAS_PAYMENT_INSTRUCTIONS=
SAAS_SUPPORT_EMAIL=
