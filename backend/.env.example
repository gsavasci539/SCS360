APP_ENV=development
BUSINESS_TIMEZONE=Europe/Istanbul
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/school_management
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IMPORTANT: Set to true ONLY for development. MUST be false in production to prevent mockdata
SEED_DEMO_DATA=false
CHATBOT_LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# Use http://ollama:11434/v1 when backend and Ollama run in Docker together.
OLLAMA_BASE_URL=http://localhost:11434/v1
CHATBOT_LLM_TIMEOUT_SECONDS=12

# School tuition merchant: explicitly bound to one institution UUID.
IYZICO_PAYMENT_ENABLED=false
IYZICO_ORGANIZATION_ID=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=

# Per-school merchant accounts use encrypted settings in the institution panel.
# Generate a separate Fernet key; keep it stable and back it up securely.
SCHOOL_PAYMENT_ENCRYPTION_KEY=
SCHOOL_PAYMENT_CALLBACK_URL=

# Platform membership merchant: separate from school tuition.
SAAS_PAYMENT_ENABLED=false
SAAS_IYZICO_API_KEY=
SAAS_IYZICO_SECRET_KEY=
SAAS_IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
SAAS_IYZICO_CALLBACK_URL=
SAAS_PORTAL_URL=
SAAS_CHECKOUT_ENCRYPTION_KEY=
SAAS_PAYMENT_INSTRUCTIONS=
SAAS_SUPPORT_EMAIL=
